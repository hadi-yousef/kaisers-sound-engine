#!/bin/bash
# Kaiser’s Sound-Engine: Oberfläche im Browser starten (wie „Sound-Engine starten.command“, aber mit Optionen)
#   ./sprich-server [--port 47811] [--netz] [--ohne-browser]
DIR="$(cd "$(dirname "$0")" && pwd)"
for P in "$SOUND_ENGINE_PYTHON" "$DIR/.venv/bin/python"; do
  if [ -n "$P" ] && [ -x "$P" ] && "$P" -c "import mlx_audio, soundfile" >/dev/null 2>&1; then
    exec env TOKENIZERS_PARALLELISM=false PYTHONWARNINGS=ignore "$P" "$DIR/server.py" "$@"
  fi
done
echo "✗ Keine Python-Umgebung mit mlx-audio gefunden. Einmal einrichten:  ./einrichten.sh"
exit 1
